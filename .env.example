APP_NAME=FlowStock
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=flowstock
DB_USERNAME=flowstock
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# REVERB_HOST is the Docker service name — this is how the Laravel app
# (PHP, inside the `app` container) reaches the `reverb` container to publish
# events. The browser can't resolve that hostname; see frontend/.env.example
# for the separate VITE_REVERB_HOST=localhost the frontend actually connects to.
REVERB_APP_ID=859246
REVERB_APP_KEY=befoiabu5fmfkrxe3pwq
REVERB_APP_SECRET=vcke1otythhjnyxeo76o
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http

AUDIT_LOG_RETENTION_DAYS=365

# Empty = trust no proxy (correct here — nginx is the outermost edge). Set to
# '*' only behind a real load balancer/ingress, or a comma-separated IP/CIDR list.
TRUSTED_PROXIES=

SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
