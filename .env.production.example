APP_NAME=FlowStock
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=flowstock
DB_USERNAME=flowstock
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Generate real values for a live deployment (e.g. `php artisan reverb:install`
# locally and copy its output, or generate your own random strings) — don't
# reuse the demo values from the dev .env.example. REVERB_HOST is the Docker
# Compose service name (the `reverb` container in docker-compose.prod.yml);
# the browser instead needs its own VITE_REVERB_HOST pointed at wherever this
# deploy actually exposes port 6001 (a public hostname, not this internal name).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http

AUDIT_LOG_RETENTION_DAYS=365

# Empty = trust no proxy. If this deploys behind a real load balancer/ingress
# (common in real cloud deployments), set to '*' or the LB's specific IP/CIDR —
# otherwise the login throttle and IP-based rate limit collapse into one
# shared bucket for every client behind it.
TRUSTED_PROXIES=

SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
